#!/bin/sh
# חוקת הפרויקט נאכפת לפני כל קומיט, לא רק ב-CI.
#
# הבדיקות האלה כבר תפסו הפרות אמיתיות (שם מותג, מחיר מנוי שנשאר ישן,
# רשימת נתיבי מחיקה כפולה). כשהן רצות רק ב-CI, ההפרה כבר בהיסטוריה ומישהו
# צריך לזכור לחזור אליה. כאן היא פשוט לא נכנסת.
#
# הפעלה חד-פעמית:  git config core.hooksPath .githooks
# עקיפה חד-פעמית:  git commit --no-verify   (רק כשאתה יודע למה)
if [ -f scripts/validate.sh ]; then
  if ! bash scripts/validate.sh; then
    echo ""
    echo "❌ הקומיט נחסם: scripts/validate.sh נכשל."
    echo "   תקן את ההפרה — אל תעקוף את הבדיקה."
    exit 1
  fi
fi
