# מפתח ה-API של Anthropic (claude.ai/settings/keys) — חובה
ANTHROPIC_API_KEY=

# המספר שלך בפורמט בינלאומי, ספרות בלבד, בלי + ובלי 0 מוביל
# לדוגמה: מספר ישראלי 050-123-4567 הופך ל-972501234567
WHATSAPP_PHONE_NUMBER=

# איזה מודל קלוד משמש לסיכום היומי (אפשר להשאיר כמו שזה)
CLAUDE_MODEL=claude-opus-5-5

# תיקייה לאחסון פרטי ההתחברות לוואטסאפ — בפריסה בענן זו צריכה להיות
# תיקייה על דיסק קבוע (persistent disk / volume), לא דיסק זמני
AUTH_DIR=./data/auth

# נתיב לקובץ ההגדרות של שמות הקבוצות
GROUPS_CONFIG_PATH=./groups.config.json

# הפורט שעליו עולה דף הסטטוס (לרוב שירותי האירוח קובעים את זה בעצמם)
PORT=3000
