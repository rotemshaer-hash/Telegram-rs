# מפתח ה-API של Anthropic (claude.ai/settings/keys) — חובה
ANTHROPIC_API_KEY=

# המספר שלך בפורמט בינלאומי, ספרות בלבד, בלי + ובלי 0 מוביל
# לדוגמה: מספר ישראלי 050-123-4567 הופך ל-972501234567
WHATSAPP_PHONE_NUMBER=

# איזה מודל קלוד משמש לסיכום היומי (אפשר להשאיר כמו שזה)
CLAUDE_MODEL=claude-opus-5-5

# תיקייה לאחסון פרטי ההתחברות לוואטסאפ — בפריסה בענן זו צריכה להיות
# תיקייה על דיסק קבוע (persistent disk / volume), לא דיסק זמני
AUTH_DIR=./data/auth

# שמות הקבוצות שעליהן עוקבים — מופרדים ב-| (פס אנכי), מדויק כמו בוואטסאפ.
# זו הדרך המומלצת בפריסה בענן (קובץ ה-JSON למטה לא עולה ל-GitHub בכוונה,
# כדי שלא יהיו שמות קבוצות פרטיים בריפו ציבורי).
GROUPS=שם הקבוצה הראשונה|שם הקבוצה השנייה

# חלופה לפיתוח מקומי: נתיב לקובץ JSON עם מערך שמות קבוצות (ראה
# groups.config.example.json). משמש רק אם GROUPS לא מוגדר.
GROUPS_CONFIG_PATH=./groups.config.json

# הפורט שעליו עולה דף הסטטוס (לרוב שירותי האירוח קובעים את זה בעצמם)
PORT=3000

# ── עוזר אישי (בצ'אט "הודעה לעצמי") ─────────────────────────────
# מודל ה-Claude של העוזר. claude-haiku-5-5 זול בהרבה, באיכות נמוכה יותר.
ASSISTANT_MODEL=claude-opus-5-5

# כמה ימים לשמור הודעות מהקבוצות על השרת (כדי שהעוזר יוכל לענות עליהן)
MESSAGE_RETENTION_DAYS=7

# Gmail — קריאה בלבד. סיסמת אפליקציה (16 אותיות) מ-myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# יומן Google — "כתובת סודית בפורמט iCal" מהגדרות היומן (קריאה בלבד)
GOOGLE_CALENDAR_ICS_URL=
