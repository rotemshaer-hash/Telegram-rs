# Local Netlify folder
.netlify
# Firebase debug logs
firebase-debug.log
.firebase/

# Test tooling
node_modules/
test-results/
playwright-report/
blob-report/
playwright/.cache/
# Sandbox-specific Playwright browser path override — not portable, never commit
playwright.local.config.js

# פלט של scripts/build-mobile-www.sh — עותק ארוז של האתר ל-iOS.
# מגונרר בזמן הבנייה ולכן לא נשמר: אחרת index.html היה יושב פעמיים בריפו,
# 1.1MB כל אחד, ושני העותקים היו נפרדים ברגע שאחד מהם משתנה.
mobile/www/*
!mobile/www/.gitkeep

# פלט דיבאג של אמולטור Firebase — נוצר בכל הרצת npm run test:rules
database-debug.log
firebase-debug.log
ui-debug.log

# סודות שלא עולים לגיבוי לעולם. אף אחד מהם אינו בריפו היום — זו הגנה מפני
# הפעם הבאה שקובץ כזה ייווצר מקומית (בודק המוכנות, 15.11.2026).
.env
.env.*
!.env.example
mobile/android/keystore.properties
mobile/android/app/keystore.properties
*.jks
*.keystore
mobile/android/app/google-services.json
mobile/ios/App/App/GoogleService-Info.plist
*serviceAccount*.json
AuthKey_*.p8
*.p12
