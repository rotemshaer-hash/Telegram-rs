{
  "rules": {
    ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",
    ".write": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",

    "teachers": { ".read": "auth != null" },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "bookings": {
      "$id": {
        ".read": "auth != null && (auth.uid == data.child('studentUid').val() || auth.uid == data.child('teacherUid').val() || auth.token.email == 'rotemshaer@gmail.com')",
        ".write": "auth != null && (auth.uid == data.child('studentUid').val() || auth.uid == newData.child('studentUid').val() || auth.token.email == 'rotemshaer@gmail.com')"
      }
    },
    "teacherBookings": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'rotemshaer@gmail.com')" }
    },
