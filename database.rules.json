{
  "rules": {
    ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",
    ".write": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",

    "teachers": { ".read": "auth != null" },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "role": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || !data.exists()"
        },
        "verified": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || newData.val() == false"
        }
      }
    },
    "bookings": {
      "$id": {
        ".read": "auth != null && (auth.uid == data.child('studentId').val() || auth.uid == data.child('teacherId').val() || auth.token.email == 'rotemshaer@gmail.com')",
        ".write": "auth != null && (auth.uid == data.child('studentId').val() || auth.uid == newData.child('studentId').val() || auth.uid == data.child('teacherId').val() || auth.uid == newData.child('teacherId').val() || auth.token.email == 'rotemshaer@gmail.com')"
      }
    },
    "teacherBookings": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'rotemshaer@gmail.com')" }
    },
    "userBookings": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$bookingId": {
          ".write": "auth != null",
          "status": {
            ".validate": "auth.uid != $uid || newData.val() == 'pending' || newData.val() == 'awaitingPayment'"
          }
        }
      }
    },
    "notifications": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null" }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null",
        "$msgId": {
          ".write": "auth != null && (!data.exists() && newData.child('from').val() == auth.uid && newData.child('text').isString() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "chats":    { "$id": { ".read": "auth != null", ".write": "auth != null" } },
    "userChats": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null" }
    },
    "adminAlerts":  { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "adminNotifs":  { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "parentTokens": {
      "$token": { ".read": "auth != null", ".write": "auth != null" }
    },
    "parentLinks": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null && auth.uid == $uid" }
    },
    "bannedUsers":  { ".read": "auth != null", ".write": "auth != null && auth.token.email == 'rotemshaer@gmail.com'" },
    "forceSignout": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null" }
    },
    "reviews":        { ".read": "auth != null", ".write": "auth != null" },
    "pendingReviews": { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "videos":         { ".read": "auth != null", ".write": "auth != null" },
    "communityPosts": { ".read": "auth != null", ".write": "auth != null" },
    "posts":          { ".read": "auth != null", ".write": "auth != null" },
    "groups":         { ".read": "auth != null", ".write": "auth != null" },
    "groupMembers":   { ".read": "auth != null", ".write": "auth != null" },
    "userGroups": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null" }
    },
    "reports":          { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "favorites": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null && auth.uid == $uid" }
    },
    "lessonSummaries": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null" }
    },
    "studentProgress": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null" }
    },
    "teacherSummaries": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null" }
    },
    "schedules": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null" }
    },
    "contactMessages":  { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "pendingCategories":{ ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "adminConfig": {
      ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",
      ".write": "auth != null && auth.token.email == 'rotemshaer@gmail.com'"
    }
  }
}
