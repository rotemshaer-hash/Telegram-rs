{
  "rules": {
    ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",
    ".write": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",

    "teachers": {
      ".read": "auth != null",
      "$teacherUid": {
        ".write": "auth != null && (auth.uid == $teacherUid || auth.token.email == 'rotemshaer@gmail.com')",
        "verified": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || newData.val() == false"
        },
        "active": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || newData.val() == false"
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "role": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || !data.exists()"
        },
        "verified": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || newData.val() == false"
        },
        "createdAt": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || !data.exists()"
        },
        "referredBy": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || !data.exists()"
        },
        "subscription": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || newData.child('status').val() != 'active'"
        },
        "parentId": {
          ".write": "auth != null && auth.uid == $uid && !data.exists()"
        }
      }
    },
    "bookings": {
      "$id": {
        ".read": "auth != null && (auth.uid == data.child('studentId').val() || auth.uid == data.child('teacherId').val() || auth.token.email == 'rotemshaer@gmail.com')",
        ".write": "auth != null && (auth.uid == data.child('studentId').val() || auth.uid == newData.child('studentId').val() || auth.uid == data.child('teacherId').val() || auth.uid == newData.child('teacherId').val() || auth.token.email == 'rotemshaer@gmail.com')"
      }
    },
    "teacherBookings": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$bookingId": {
          ".write": "auth != null && (auth.uid == $uid || root.child('bookings').child($bookingId).child('studentId').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')",
          "status": {
            ".validate": "auth.uid == $uid || auth.token.email == 'rotemshaer@gmail.com' || newData.val() == 'cancelled'"
          }
        }
      }
    },
    "userBookings": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$bookingId": {
          ".write": "auth != null && (auth.uid == $uid || root.child('bookings').child($bookingId).child('teacherId').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')",
          "status": {
            ".validate": "auth.uid != $uid || newData.val() == 'pending' || newData.val() == 'awaitingPayment' || newData.val() == 'cancelled'"
          }
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$notifId": {
          ".write": "auth != null",
          ".validate": "!newData.exists() || (data.exists() && newData.child('read').isBoolean()) || (!data.exists() && newData.hasChildren(['type', 'createdAt', 'read']) && newData.child('createdAt').isNumber() && newData.child('read').isBoolean() && (newData.child('type').val() == 'newBooking' || newData.child('type').val() == 'bookingApproved' || newData.child('type').val() == 'bookingRejected' || newData.child('type').val() == 'bookingCancelled' || newData.child('type').val() == 'newMessage' || newData.child('type').val() == 'lessonCompleted' || newData.child('type').val() == 'newReview' || newData.child('type').val() == 'newPost' || newData.child('type').val() == 'adminMessage' || newData.child('type').val() == 'accountApproved' || newData.child('type').val() == 'teacherApproved' || newData.child('type').val() == 'studentApproved' || newData.child('type').val() == 'groupJoin' || newData.child('type').val() == 'groupApproved' || newData.child('type').val() == 'groupRejected' || newData.child('type').val() == 'rateLesson' || newData.child('type').val() == 'lessonSummary' || newData.child('type').val() == 'newTeacher' || newData.child('type').val() == 'newUser' || newData.child('type').val() == 'newVideo' || newData.child('type').val() == 'newReport' || newData.child('type').val() == 'briefProposal' || newData.child('type').val() == 'briefAccepted' || newData.child('type').val() == 'newQuestion' || newData.child('type').val() == 'questionAnswered' || newData.child('type').val() == 'trialReminder'))"
        }
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && (root.child('chatParticipants').child($chatId).child(auth.uid).exists() || auth.token.email == 'rotemshaer@gmail.com')",
        ".write": "auth != null",
        "$msgId": {
          ".write": "auth != null && (!data.exists() && newData.child('from').val() == auth.uid && newData.child('text').isString() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "chatParticipants": {
      "$chatId": {
        ".read": "auth != null && root.child('chatParticipants').child($chatId).child(auth.uid).exists()",
        ".write": "auth != null"
      }
    },
    "chats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "userChats": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null" }
    },
    "adminAlerts":  { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "adminNotifs":  { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "parentTokens": {
      "$token": { ".read": "auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth.token.email == 'rotemshaer@gmail.com'" }
    },
    "parentLinks": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null && auth.uid == $uid" }
    },
    "bannedUsers": {
      ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",
      ".write": "auth != null && auth.token.email == 'rotemshaer@gmail.com'"
    },
    "forceSignout": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth.uid == $uid || auth.token.email == 'rotemshaer@gmail.com'" }
    },
    "reviews": {
      ".read": "auth != null",
      "$teacherId": {
        "$reviewId": {
          ".write": "auth != null && (!data.exists() && newData.child('from').val() == auth.uid || data.child('from').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')",
          "approved": {
            ".validate": "auth.token.email == 'rotemshaer@gmail.com' || newData.val() != true"
          }
        }
      }
    },
    "pendingReviews": { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "videos": {
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth.uid == $teacherId || auth.token.email == 'rotemshaer@gmail.com'",
        "$videoId": {
          "approved": {
            ".validate": "auth.token.email == 'rotemshaer@gmail.com' || newData.val() != true"
          }
        }
      }
    },
    "communityPosts": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && (!data.exists() && newData.child('authUid').val() == auth.uid || data.child('authUid').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')",
        ".validate": "!newData.exists() || (newData.hasChildren(['authUid', 'author', 'createdAt']) && (newData.child('text').isString() || newData.child('mediaUrl').isString()))",
        "status": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || newData.val() != 'approved'"
        }
      }
    },
    "teacherQA": {
      "$teacherUid": {
        ".read": "auth != null",
        "$qaId": {
          ".write": "auth != null && (!data.exists() && newData.child('askerUid').val() == auth.uid || auth.uid == $teacherUid || data.child('askerUid').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')"
        }
      }
    },
    "parentBriefs": {
      ".read": "auth != null",
      "$briefId": {
        ".write": "auth != null && (!data.exists() && newData.child('parentUid').val() == auth.uid || data.child('parentUid').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')"
      }
    },
    "briefProposals": {
      "$briefId": {
        ".read": "auth != null",
        "$teacherUid": {
          ".write": "auth != null && (auth.uid == $teacherUid || auth.token.email == 'rotemshaer@gmail.com')"
        }
      }
    },
    "messageStats": {
      "$teacherUid": {
        ".read": "auth.uid == $teacherUid || auth.token.email == 'rotemshaer@gmail.com'",
        ".write": "auth != null"
      }
    },
    "posts": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && (!data.exists() && newData.child('authUid').val() == auth.uid || data.child('authUid').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')"
      }
    },
    "groups": {
      ".read": "auth != null",
      "$groupId": {
        ".write": "auth != null && (data.child('teacherId').val() == auth.uid || !data.exists() || auth.token.email == 'rotemshaer@gmail.com')"
      }
    },
    "groupMembers": {
      "$groupId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid == $uid || root.child('groups').child($groupId).child('teacherId').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')",
          "status": {
            ".validate": "auth.uid != $uid || auth.token.email == 'rotemshaer@gmail.com' || root.child('groups').child($groupId).child('teacherId').val() == auth.uid || newData.val() == 'pending'"
          }
        }
      }
    },
    "userGroups": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$groupId": {
          ".write": "auth != null && (auth.uid == $uid || root.child('groups').child($groupId).child('teacherId').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')"
        }
      }
    },
    "reports": { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "favorites": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth != null && auth.uid == $uid" }
    },
    "lessonSummaries": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth.uid == $uid || auth.token.email == 'rotemshaer@gmail.com'" }
    },
    "studentProgress": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$bookingId": {
          ".write": "auth.uid == $uid || root.child('bookings').child($bookingId).child('teacherId').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com'"
        }
      }
    },
    "teacherSummaries": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth.uid == $uid || auth.token.email == 'rotemshaer@gmail.com'" }
    },
    "schedules": {
      "$uid": { ".read": "auth != null && auth.uid == $uid", ".write": "auth.uid == $uid || auth.token.email == 'rotemshaer@gmail.com'" }
    },
    "contactMessages": { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "pendingCategories": { ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'", ".write": "auth != null" },
    "stories": {
      ".read": "auth != null",
      "$storyId": {
        ".write": "auth != null && (!data.exists() && newData.child('uid').val() == auth.uid || data.child('uid').val() == auth.uid || auth.token.email == 'rotemshaer@gmail.com')",
        "status": {
          ".validate": "auth.token.email == 'rotemshaer@gmail.com' || newData.val() != 'approved'"
        }
      }
    },
    "adminConfig": {
      ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",
      ".write": "auth != null && auth.token.email == 'rotemshaer@gmail.com'"
    },
    "emailRateLimit": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "_analytics": {
      ".read": "auth != null && auth.token.email == 'rotemshaer@gmail.com'",
      "$month": {
        ".write": "auth != null"
      }
    },
    "refCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid)"
      }
    },
    "userCredits": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth.uid == $uid || auth.token.email == 'rotemshaer@gmail.com'"
      }
    },
    "referrals": {
      "$referrerUid": {
        ".read": "auth != null && auth.uid == $referrerUid",
        ".write": "auth != null"
      }
    }
  }
}
 
